{
  "manifest_version": 2,
  "id": "maibot-community.maiwill",
  "version": "0.1.30",
  "name": "MaiWill（麦意）",
  "description": "以一个可恢复的逻辑意志会话统筹 MaiBot 自主能力。",
  "author": {
    "name": "MaiWill contributors",
    "url": "https://github.com/Mai-with-u"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/Mai-with-u/MaiWill",
    "homepage": "https://github.com/Mai-with-u/MaiWill",
    "documentation": "https://github.com/Mai-with-u/MaiWill",
    "issues": "https://github.com/Mai-with-u/MaiWill/issues"
  },
  "host_application": {
    "min_version": "1.3.14",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "999.999.999"
  },
  "dependencies": [],
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "brain"
    }
  },
  "capabilities": ["config.get", "llm.generate", "knowledge.search", "maisaka.proactive.trigger"],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}

